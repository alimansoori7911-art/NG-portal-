# نمونه‌ی تنظیمات — این فایل در گیت است، خودِ `.env` نیست.
#
# راه‌اندازی:
#   cp .env.example .env
# بعد آدرس را به بک‌اند خودت عوض کن.
#
# ⚠️ بعد از هر تغییر در `.env` باید `npm run dev` را ری‌استارت کنی؛
#    Vite متغیرها را فقط موقع بالا آمدن می‌خواند.

# آدرس بک‌اند. بدون اسلش آخر.
# اگر بک‌اند روی همین کامپیوتر است: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# داده‌ی نمونه‌ی محصولات و پلن‌ها به‌جای بک‌اند واقعی.
#
# ⚠️ فقط برای کار روی ظاهر، وقتی بک‌اند بالا نیست. با `true` شناسه‌ی
#    پلن‌ها ساختگی است و ثبت سفارش کار **نمی‌کند** (بک‌اند `plan_id`
#    عددی می‌خواهد). برای کار واقعی `false` بگذار.
VITE_USE_MOCK_PRODUCTS=false
